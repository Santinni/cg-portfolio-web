{
  "name": "cg-portfolio-web",
  "version": "0.1.0",
  "description": "CodeGuy personal website",
  "author": "CodeGuy <karel@codeguy.cz>",
  "license": "MIT",
  "homepage": "https://codeguy.cz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Santinni/cg-portfolio-web"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.12.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not IE > 0"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --experimental-build-mode compile",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "clean": "rm -rf .next node_modules",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "icons:scan": "node scripts/iconConverter/icon-processor.cjs",
    "icons:list": "node scripts/iconConverter/listfiles.cjs ./src/assets/icons \"**/*.svg\" files.json",
    "icons:convert": "node scripts/iconConverter/icon-converter.cjs",
    "icons:index": "node scripts/iconConverter/listfiles.cjs ./src/components/icons \"**/*.tsx\" files.json",
    "icons:generate": "pnpm run icons:scan && pnpm run icons:convert && pnpm run icons:index",
    "icons:clean": "rimraf \"src/components/icons/*.tsx\" && rimraf icon-scan-report.json"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.15.0",
    "@payloadcms/next": "^3.15.0",
    "@payloadcms/payload-cloud": "^3.15.0",
    "@payloadcms/richtext-lexical": "^3.15.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "lucide-react": "^0.469.0",
    "next": "15.1.0",
    "payload": "^3.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.58.2",
    "@svgr/cli": "^8.1.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "fast-glob": "^3.3.3",
    "fdir": "^6.5.0",
    "jsdom": "^28.1.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
