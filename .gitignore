# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.playwright-mcp

# local working artifacts (browser evidence, asset and PDF extraction dumps)
/tmp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Docker volumes
docker/volumes/
postgres_data/
caddy_data/
caddy_config/

# Logs
*.log

# Icon converter artifacts
icon-scan-report.json
src/assets/**/files.json
src/components/**/files.json

# CV PDF build artefacts
tools/cv-pdf/out/
