{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"files": {
		"includes": [
			"src/app/(frontend)/**/*.tsx",
			"src/app/(frontend)/**/*.ts",
			"src/app/*/(frontend)/**/*.tsx",
			"src/app/*/(frontend)/**/*.ts",
			"src/app/robots.ts",
			"src/app/sitemap.ts",
			"src/components/article/**/*.tsx",
			"src/components/site/**/*.tsx",
			"src/components/work/**/*.tsx",
			"src/content/**/*.ts",
			"src/i18n/**/*.ts",
			"src/__tests__/**/*.ts",
			"src/__tests__/**/*.tsx",
			"src/proxy.ts",
			"src/global.d.ts",
			"src/app/global-not-found.tsx",
			"src/collections/**/*.ts",
			"src/access/**/*.ts",
			"src/lib/**/*.ts",
			"messages/*.json",
			"next.config.ts",
			"playwright.config.ts",
			"biome.json"
		]
	},
	"linter": {
		"enabled": false
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
