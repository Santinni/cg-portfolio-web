# Environment for the Caddy container only (never the Next.js app). Production copy lives at
# /opt/codeguy/.env.caddy with mode 0600 and is not committed.
#
# Generate the bcrypt hash of the jobs.codeguy.cz password interactively, so the password never
# lands in shell history:
#
#   docker run --rm -it caddy:2.11.4-alpine caddy hash-password
#
# Keep the value in single quotes. A bcrypt hash starts with $2a$14$...; without single quotes
# Compose would interpolate those dollar signs and hand Caddy a broken hash. An empty or missing
# value makes `caddy validate` fail, which stops the deploy before Caddy is replaced.
JOBS_BASIC_AUTH_HASH='replace-with-bcrypt-hash'
